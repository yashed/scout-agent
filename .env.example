# --- LLM routing ------------------------------------------------------------
# USE_LLM_PROVIDER selects how the agent reaches its chat model:
#   false (default) -> call OpenAI directly with OPENAI_API_KEY below.
#   true            -> route through the Agent Manager LLM proxy / AI gateway
#                      using LLM_PROVIDER_URL + LLM_PROVIDER_KEY. The proxy is
#                      OpenAI-compatible and authenticates via the API-Key
#                      header; the key is gateway-scoped, NOT a raw OpenAI key.
# When platform-hosted, connect an LLM provider to the agent and map its URL to
# LLM_PROVIDER_URL and its API key to LLM_PROVIDER_KEY (Configure -> the LLM
# provider connection), then set USE_LLM_PROVIDER=true.
USE_LLM_PROVIDER=false
LLM_PROVIDER_URL=
LLM_PROVIDER_KEY=

# --- OpenAI (direct) --------------------------------------------------------
# Used only when USE_LLM_PROVIDER=false. OPENAI_MODEL applies to both modes
# (for the proxy it must be a model the connected LLM provider serves).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- MCP Tool Configurations --------------------------------------------------
# Injected automatically by Agent Manager when this agent is platform-hosted
# and has the corresponding proxy attached under Configure -> Tool
# Configurations. Set these yourself only when running locally against a
# deployed MCP proxy, or when running as an externally-hosted agent.
FETCH_URL=
FETCH_API_KEY=
DEEPWIKI_URL=
DEEPWIKI_API_KEY=

# --- AgentID (auto-injected on platform-hosted agents) -----------------------
# See https://wso2.github.io/agent-manager/docs/next/tutorials/use-agentid-in-platform-hosted-agents/
AMP_AGENTID_CLIENT_ID=
AMP_AGENTID_CLIENT_SECRET=
AMP_AGENTID_TOKEN_ENDPOINT=
AMP_AGENTID_SCOPES=

# --- OBO (delegated / On-Behalf-Of access) -----------------------------------
# false (default) -> MCP calls use this agent's own client_credentials AgentID
#                     identity (AMP_AGENTID_* above).
# true            -> MCP calls instead exchange the caller's own forwarded
#                     access token for one scoped to the target MCP resource
#                     (RFC 8693 token exchange), acting on the caller's behalf
#                     instead of as the agent. Requires, in Agent Manager:
#                       - this agent's "Invocation security is OAuth" and
#                         "Token forwarding" both enabled (Configure page)
#                       - the AgentID's token-exchange grant enabled (the
#                         "Enable Delegated Access" toggle on Agent ID ->
#                         Delegated Access (OBO), once its readiness checklist
#                         is all green)
#                       - a trusted issuer Connection enabled for this
#                         environment, with an authorization mapping rule
#                         covering the calling user/token
# See obo_identity.py's module docstring for exactly which OAuth parameters
# ThunderID honors here, confirmed against its own grant handler.
AMP_OBO_ENABLED=false

# Scopes to request per MCP proxy when exchanging. REQUIRED for the exchange
# to grant anything: when the trusted issuer's authorization is mapping-based
# (the normal case) and no scope is requested, ThunderID grants an empty
# scope set rather than "whatever the mapping allows". Match these to the
# scope names your authorization mapping's target role actually grants.
FETCH_OBO_SCOPES=
DEEPWIKI_OBO_SCOPES=
