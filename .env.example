# --- OpenAI -----------------------------------------------------------------
# Required. Used by the LangGraph agent for its chat model.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- MCP Tool Configurations --------------------------------------------------
# Injected automatically by Agent Manager when this agent is platform-hosted
# and has the corresponding proxy attached under Configure -> Tool
# Configurations. Set these yourself only when running locally against a
# deployed MCP proxy, or when running as an externally-hosted agent.
FETCH_URL=
FETCH_API_KEY=
DEEPWIKI_URL=
DEEPWIKI_API_KEY=
