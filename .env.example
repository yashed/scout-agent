# --- LLM routing ------------------------------------------------------------
# USE_LLM_PROVIDER selects how the agent reaches its chat model:
#   false (default) -> call OpenAI directly with OPENAI_API_KEY below.
#   true            -> route through the Agent Manager LLM proxy / AI gateway
#                      using LLM_PROVIDER_URL + LLM_PROVIDER_KEY. The proxy is
#                      OpenAI-compatible and authenticates via the API-Key
#                      header; the key is gateway-scoped, NOT a raw OpenAI key.
# When platform-hosted, connect an LLM provider to the agent and map its URL to
# LLM_PROVIDER_URL and its API key to LLM_PROVIDER_KEY (Configure -> the LLM
# provider connection), then set USE_LLM_PROVIDER=true.
USE_LLM_PROVIDER=false
LLM_PROVIDER_URL=
LLM_PROVIDER_KEY=

# --- OpenAI (direct) --------------------------------------------------------
# Used only when USE_LLM_PROVIDER=false. OPENAI_MODEL applies to both modes
# (for the proxy it must be a model the connected LLM provider serves).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- MCP Tool Configurations --------------------------------------------------
# Injected automatically by Agent Manager when this agent is platform-hosted
# and has the corresponding proxy attached under Configure -> Tool
# Configurations. Set these yourself only when running locally against a
# deployed MCP proxy, or when running as an externally-hosted agent.
FETCH_URL=
FETCH_API_KEY=
DEEPWIKI_URL=
DEEPWIKI_API_KEY=
